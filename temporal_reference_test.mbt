    let config = @hocon.parse_sources(
      { name: "<string>", content: "a=[\"106750d\"]", format: "hocon", },
      object_only=true,
      includes={},
      environment={},
      fallbacks=[],
    )
    (
      true,
      @hocon.get_duration_list_in(config, "a", @hocon.Milliseconds)
      .map(n => n.to_string())
      .to_json(),
    )
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (true, @json.parse("[\"9223200000000\"]")))
}

