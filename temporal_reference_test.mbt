// Independent Lightbend Config 1.4.9 results; node tools/generate-temporal-tests.mjs then moon fmt.

///|
test "official temporal 0" {
  let actual = try {
    let config = @hocon.parse_sources(
      { name: "<string>", content: "a=\"0\"", format: "hocon", },
      object_only=true,
      includes={},
      environment={},
      fallbacks=[],
    )
    (true, @hocon.get_period(config, "a").to_json())
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(
    actual,
    (true, @json.parse("{\"days\":0,\"months\":0,\"years\":0}")),
  )
}

