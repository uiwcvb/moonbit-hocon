    let config = @hocon.parse_sources(
      { name: "<string>", content: "a=[1]", format: "hocon", },
      object_only=true,
      includes={},
      environment={},
      fallbacks=[],
    )
    (
      true,
      @hocon.get_duration_in(config, "a", @hocon.Nanoseconds)
      .to_string()
      .to_json(),
    )
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (false, @json.parse("null")))
}

