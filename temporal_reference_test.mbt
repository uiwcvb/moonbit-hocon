  let actual = try {
    let config = @hocon.parse_sources(
      {
        name: "<string>",
        content: "a=\"-9223372036854775808ms\"",
        format: "hocon",
      },
      object_only=true,
      includes={},
      environment={},
      fallbacks=[],
    )
    (true, @hocon.get_period(config, "a").to_json())
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (false, @json.parse("null")))
}

///|
test "official temporal 1221" {
  let actual = try {
    let config = @hocon.parse_sources(
      {
        name: "<string>",
        content: "a=\"-9223372036854775808ms\"",
        format: "hocon",
      },
      object_only=true,
      includes={},
      environment={},
      fallbacks=[],
    )
    (true, @hocon.get_temporal(config, "a").to_json())
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(
    actual,
    (
      true,
      @json.parse(
        "{\"kind\":\"duration\",\"nanoseconds\":\"-9223372036854775808\"}",
      ),
    ),
  )
}

