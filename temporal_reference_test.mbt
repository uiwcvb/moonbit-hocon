    let config = @hocon.parse_sources(
      { name: "<string>", content: "a=\"106750d\"", format: "hocon", },
      object_only=true,
      includes={},
      environment={},
      fallbacks=[],
    )
    (
      true,
      @hocon.get_duration_in(config, "a", @hocon.Seconds).to_string().to_json(),
    )
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (true, @json.parse("\"9223200000\"")))
}

///|
test "official temporal 2155" {
