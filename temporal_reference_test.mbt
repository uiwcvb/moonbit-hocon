    let config = @hocon.parse_sources(
      { name: "<string>", content: "a=\"306783378months\"", format: "hocon", },
      object_only=true,
      includes={},
      environment={},
      fallbacks=[],
    )
    (true, @hocon.get_period(config, "a").to_json())
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(
    actual,
    (true, @json.parse("{\"days\":0,\"months\":306783378,\"years\":0}")),
  )
}

