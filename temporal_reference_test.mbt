    let config = @hocon.parse_sources(
      { name: "<string>", content: "a=\"-106752d\"", format: "hocon", },
      object_only=true,
      includes={},
      environment={},
      fallbacks=[],
    )
    (true, @hocon.get_temporal(config, "a").to_json())
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(
    actual,
    (
      true,
      @json.parse(
        "{\"kind\":\"duration\",\"nanoseconds\":\"-9223372036854775808\"}",
      ),
    ),
  )
}

