    let config = @hocon.parse_sources(
      { name: "<string>", content: "nested.a=\"2months\"", format: "hocon", },
      object_only=true,
      includes={},
      environment={},
      fallbacks=[],
    )
    (
      true,
      @hocon.get_milliseconds_list(config, "nested.a")
      .map(n => n.to_string())
      .to_json(),
    )
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (false, @json.parse("null")))
}

