      })
    }
    Json::object(out)
  })
  assert_eq(
    actual,
    @json.parse(
      "{\"accepted\":true,\"value\":{\"outer.a\":{\"hash\":{\"accepted\":true,\"value\":627015174},\"render\":{\"accepted\":true,\"value\":\"${outer.x}\"},\"type\":{\"accepted\":false},\"unwrap\":{\"accepted\":false}},\"outer.b\":{\"hash\":{\"accepted\":true,\"value\":1476657332},\"render\":{\"accepted\":true,\"value\":\"${outer.missing}\"},\"type\":{\"accepted\":false},\"unwrap\":{\"accepted\":false}},\"outer.list\":{\"hash\":{\"accepted\":true,\"value\":1463488980},\"render\":{\"accepted\":true,\"value\":\"[${?outer.ENV[]}]\"},\"type\":{\"accepted\":true,\"value\":\"LIST\"},\"unwrap\":{\"accepted\":false}},\"outer.x\":{\"hash\":{\"accepted\":true,\"value\":1},\"render\":{\"accepted\":true,\"value\":\"1\"},\"type\":{\"accepted\":true,\"value\":\"NUMBER\"},\"unwrap\":{\"accepted\":true,\"value\":1}}}}",
    ),
  )
}

///|
fn entry_native_case_1225() -> Unit raise {
  let actual = value_native_attempt(() => {
    let config = @hocon.parse_unresolved(
      "outer { include \"part\" }",
      includes=Map([("part", "empty={}\nn=null\n\"a.b\"=4")]),
    )
    let out : Map[String, Json] = Map([])
    for key, value in @hocon.entry_set(config) {
      out[key] = Json::object({
        "type": value_native_attempt(() => @hocon.value_type(value).to_json()),
        "unwrap": value_native_attempt(() => {
          @json.parse(@hocon.value_unwrapped(value).to_json_string())
        }),
        "render": value_native_attempt(() => {
          @hocon.render_value(value).to_json()
        }),
        "hash": value_native_attempt(() => @hocon.value_hash(value).to_json()),
      })
    }
    Json::object(out)
  })
  assert_eq(
    actual,
    @json.parse(
      "{\"accepted\":true,\"value\":{\"outer.\\\"a.b\\\"\":{\"hash\":{\"accepted\":true,\"value\":4},\"render\":{\"accepted\":true,\"value\":\"4\"},\"type\":{\"accepted\":true,\"value\":\"NUMBER\"},\"unwrap\":{\"accepted\":true,\"value\":4}}}}",
    ),
  )
}

