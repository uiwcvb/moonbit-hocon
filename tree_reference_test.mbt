    let mut config = @hocon.parse_sources(
      { name: "<string>", content: "a=[1,null,{b=2}]", format: "hocon", },
      object_only=true,
    )
    config = @hocon.with_only_key(config, "a.b.c")
    (true, @json.parse(config.to_json_string()))
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (true, @json.parse("{}")))
}

