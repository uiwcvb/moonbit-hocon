    let mut config = @hocon.parse_sources(
      {
        name: "<string>",
        content: "\"a.b\"={\"\"=1}\na={\"x.y\"=2}",
        format: "hocon",
      },
      object_only=true,
    )
    config = @hocon.with_value(
      config,
      "a..b",
      @hocon.get_path(@hocon.parse("value=9"), ["value"]).unwrap(),
    )
    (true, @json.parse(config.to_json_string()))
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (false, @json.parse("null")))
}

///|
test "official tree 1899" {
