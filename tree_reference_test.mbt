    let config = @hocon.parse_sources(
      { name: "<string>", content: "\"ㇰ\"=1", format: "hocon", },
      object_only=true,
    )
    (
      true,
      @json.parse(@hocon.Object(@hocon.entry_set(config)).to_json_string()),
    )
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (true, @json.parse("{\"ㇰ\":1}")))
}

