    let config = @hocon.parse_sources(
      { name: "<string>", content: "a=[[],[1]]", format: "hocon", },
      object_only=true,
    )
    (
      true,
      tree_test_problems(
        @hocon.validation_problems(
          config,
          @hocon.parse("a={b=1,c=true}\nx=[]"),
          paths=["a.b"],
        ),
      ),
    )
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (true, @json.parse("[\"a.b\\nmissing\"]")))
}

