      @hocon.parse("\"a.b\"={\"\"=1}\na={\"x.y\"=2}"),
    )
    (true, @json.parse(config.to_json_string()))
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(
    actual,
    (
      true,
      @json.parse(
        "{\"1\":2,\"\":{\"a\":1},\"-\":3,\"a\":{\"x.y\":2},\"a.b\":{\"\":1},\"é\":4,\"中\":5}",
      ),
    ),
  )
}

