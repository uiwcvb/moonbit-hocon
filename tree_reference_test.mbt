  let actual = try {
    let mut config = @hocon.parse_sources(
      { name: "<string>", content: "a=1", format: "hocon", },
      object_only=true,
    )
    config = @hocon.at_key(config, "a..b")
    (true, @json.parse(config.to_json_string()))
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (true, @json.parse("{\"a..b\":{\"a\":1}}")))
}

