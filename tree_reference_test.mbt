    let mut config = @hocon.parse_sources(
      { name: "<string>", content: "a={b=1,c=2}\nx=3", format: "hocon", },
      object_only=true,
    )
    config = @hocon.with_key_value(
      config,
      "a.\"\"",
      @hocon.get_path(@hocon.parse("value=null"), ["value"]).unwrap(),
    )
    (true, @json.parse(config.to_json_string()))
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(
    actual,
    (true, @json.parse("{\"a\":{\"b\":1,\"c\":2},\"a.\\\"\\\"\":null,\"x\":3}")),
  )
}

