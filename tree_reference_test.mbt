    let config = @hocon.parse_sources(
      { name: "<string>", content: "a=[{y=true}]", format: "hocon", },
      object_only=true,
    )
    (
      true,
      tree_test_problems(
        @hocon.validation_problems(config, @hocon.parse("a=null"), paths=["a.b"]),
      ),
    )
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (true, @json.parse("[]")))
}

