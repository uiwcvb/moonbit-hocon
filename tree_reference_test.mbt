// Independent saved Lightbend 1.4.9 results; node tools/generate-tree-tests.mjs then moon fmt.

///|
fn tree_test_problems(problems : Array[@hocon.ValidationProblem]) -> Json {
  let items = problems.map(p => p.path + "\n" + p.kind)
  items.sort_by((a, b) => a.lexical_compare(b))
  items.to_json()
}

///|
test "official tree 0" {
  let actual = try {
    let mut config = @hocon.parse_sources(
      { name: "<string>", content: "{}", format: "hocon", },
      object_only=true,
    )
    config = @hocon.without_path(config, "a")
    (true, @json.parse(config.to_json_string()))
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (true, @json.parse("{}")))
}

