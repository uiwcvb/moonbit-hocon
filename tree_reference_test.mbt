  let actual = try {
    let mut config = @hocon.parse_sources(
      { name: "<string>", content: "{}", format: "hocon", },
      object_only=true,
    )
    config = @hocon.with_value(
      config,
      "x",
      @hocon.get_path(@hocon.parse("value=[]"), ["value"]).unwrap(),
    )
    (true, @json.parse(config.to_json_string()))
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (true, @json.parse("{\"x\":[]}")))
}

