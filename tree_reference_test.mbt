    let mut config = @hocon.parse_sources(
      {
        name: "<string>",
        content: "\"\"={a=1}\n\"1\"=2\n\"-\"=3\n\"é\"=4\n\"中\"=5",
        format: "hocon",
      },
      object_only=true,
    )
    config = @hocon.with_only_path(config, "x")
    (true, @json.parse(config.to_json_string()))
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (true, @json.parse("{}")))
}

