    let mut config = @hocon.parse_sources(
      { name: "<string>", content: "a=1", format: "hocon", },
      object_only=true,
    )
    config = @hocon.with_value(
      config,
      "a.b.c.d",
      @hocon.get_path(@hocon.parse("value=\"text\""), ["value"]).unwrap(),
    )
    (true, @json.parse(config.to_json_string()))
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(
    actual,
    (true, @json.parse("{\"a\":{\"b\":{\"c\":{\"d\":\"text\"}}}}")),
  )
}

