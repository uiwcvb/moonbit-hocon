    let mut config = @hocon.parse_sources(
      { name: "<string>", content: "a=1", format: "hocon", },
      object_only=true,
    )
    config = @hocon.with_value(
      config,
      "\"unclosed",
      @hocon.get_path(@hocon.parse("value=[1,null]"), ["value"]).unwrap(),
    )
    (true, @json.parse(config.to_json_string()))
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (false, @json.parse("null")))
}

