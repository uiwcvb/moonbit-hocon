    config = @hocon.without_path(config, "a.b")
    config = @hocon.with_fallback(config, @hocon.parse("a={b=3,c=4}\nx=5"))
    config = @hocon.with_only_path(config, "a")
    (
      true,
      @json.parse(@hocon.Object(@hocon.entry_set(config)).to_json_string()),
    )
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (false, @json.parse("null")))
}

///|
test "official tree 4367" {
  let actual = try {
    let config = @hocon.parse_sources(
      { name: "<string>", content: "{}", format: "hocon", },
      object_only=true,
    )
    @hocon.check_valid(config, @hocon.parse("a=1\nb=true"), paths=[])
    (true, @json.parse(config.to_json_string()))
  } catch {
    @hocon.ValidationFailed(problems) => (false, tree_test_problems(problems))
    _ => (false, Json::null())
  }
  assert_eq(actual, (false, @json.parse("[\"a\\nmissing\",\"b\\nmissing\"]")))
}

