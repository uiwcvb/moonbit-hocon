    )
    config = @hocon.with_key_value(
      config,
      "a..b",
      @hocon.get_path(@hocon.parse("value=9"), ["value"]).unwrap(),
    )
    (true, @json.parse(config.to_json_string()))
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(
    actual,
    (true, @json.parse("{\"a\":{\"x.y\":2},\"a..b\":9,\"a.b\":{\"\":1}}")),
  )
}

