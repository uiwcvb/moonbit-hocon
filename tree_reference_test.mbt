      config,
      "\"unclosed",
      @hocon.get_path(@hocon.parse("value=\"text\""), ["value"]).unwrap(),
    )
    (true, @json.parse(config.to_json_string()))
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(
    actual,
    (
      true,
      @json.parse(
        "{\"\\\"unclosed\":\"text\",\"a\":{\"x.y\":2},\"a.b\":{\"\":1}}",
      ),
    ),
  )
}

