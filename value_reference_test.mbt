  let results : Array[Json] = []
  results.push(
    value_native_attempt(() => {
      if values.length() <= 0 {
        raise Failure("missing prior value")
      }
      let next = @hocon.object_get(values[0], "a").unwrap()
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  results.push(
    value_native_attempt(() => {
      if values.length() <= 0 {
        raise Failure("missing prior value")
      }
      let next = value_native_create("0")
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  results.push(
    value_native_attempt(() => {
      if values.length() <= 2 {
        raise Failure("missing prior value")
      }
      let next = @hocon.with_fallback(values[1], values[2])
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  results.push(
    value_native_attempt(() => {
      if values.length() <= 3 {
        raise Failure("missing prior value")
      }
      let next = @hocon.resolve(values[3], allow_unresolved=true)
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  assert_eq(
    Json::object({
      "results": results.to_json(),
      "final": values.map(value_native_snapshot).to_json(),
    }),
    @json.parse(
      "{\"final\":[{\"type\":{\"accepted\":true,\"value\":\"OBJECT\"},\"unwrapped\":{\"accepted\":true,\"value\":{\"a\":{\"x\":1}}}},{\"type\":{\"accepted\":true,\"value\":\"OBJECT\"},\"unwrapped\":{\"accepted\":true,\"value\":{\"x\":1}}},{\"type\":{\"accepted\":true,\"value\":\"NUMBER\"},\"unwrapped\":{\"accepted\":true,\"value\":0}},{\"type\":{\"accepted\":true,\"value\":\"OBJECT\"},\"unwrapped\":{\"accepted\":true,\"value\":{\"x\":1}}},{\"type\":{\"accepted\":true,\"value\":\"OBJECT\"},\"unwrapped\":{\"accepted\":true,\"value\":{\"x\":1}}}],\"results\":[{\"accepted\":true,\"value\":1},{\"accepted\":true,\"value\":2},{\"accepted\":true,\"value\":3},{\"accepted\":true,\"value\":4}]}",
    ),
  )
}

