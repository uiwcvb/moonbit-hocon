///|
fn value_native_create(source : String) -> @hocon.Value raise {
  @hocon.object_get(@hocon.parse_unresolved("v=" + source), "v").unwrap()
}

///|
fn value_native_attempt(work : () -> Json raise) -> Json {
  Json::object({ "accepted": true, "value": work() }) catch {
    _ => Json::object({ "accepted": false })
  }
}

///|
fn value_native_snapshot(value : @hocon.Value) -> Json {
  Json::object({
    "type": value_native_attempt(() => @hocon.value_type(value).to_json()),
    "unwrapped": value_native_attempt(() => {
      @json.parse(@hocon.value_unwrapped(value).to_json_string())
    }),
  })
}

