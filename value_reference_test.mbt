  let results : Array[Json] = []
  results.push(
    value_native_attempt(() => {
      if values.length() <= 0 {
        raise Failure("missing prior value")
      }
      let next = value_native_create("null")
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  results.push(
    value_native_attempt(() => {
      if values.length() <= 0 {
        raise Failure("missing prior value")
      }
      let next = value_native_create("{}")
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  results.push(
