  let values : Array[@hocon.Value] = [@hocon.parse_unresolved("{}")]
  let results : Array[Json] = []
  results.push(
    value_native_attempt(() => {
      if values.length() <= 0 {
        raise Failure("missing prior value")
      }
      let next = value_native_create("{}")
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  results.push(
    value_native_attempt(() => {
      if values.length() <= 0 {
        raise Failure("missing prior value")
      }
      let next = value_native_create("{x=${other}}")
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  results.push(
    value_native_attempt(() => {
      if values.length() <= 2 {
        raise Failure("missing prior value")
      }
      let next = @hocon.value_with_fallback(values[1], values[2])
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  results.push(
    value_native_attempt(() => {
      if values.length() <= 0 {
        raise Failure("missing prior value")
      }
      let next = value_native_create("{x=11,y=12,z=13}")
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  results.push(
    value_native_attempt(() => {
      if values.length() <= 4 {
        raise Failure("missing prior value")
      }
      let next = @hocon.without_key(values[3], "x")
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  results.push(
    value_native_attempt(() => {
      if values.length() <= 5 {
        raise Failure("missing prior value")
      }
      let next = @hocon.value_with_fallback(values[5], values[4])
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  results.push(
    value_native_attempt(() => {
      if values.length() <= 6 {
        raise Failure("missing prior value")
      }
      let next = @hocon.at_path(values[6], "outer.a")
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  results.push(
    value_native_attempt(() => {
      if values.length() <= 7 {
        raise Failure("missing prior value")
      }
      let next = @hocon.resolve(values[7], allow_unresolved=true)
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  assert_eq(
    Json::object({
      "results": results.to_json(),
      "final": values.map(value_native_snapshot).to_json(),
    }),
    @json.parse(
      "{\"final\":[{\"type\":{\"accepted\":true,\"value\":\"OBJECT\"},\"unwrapped\":{\"accepted\":true,\"value\":{}}},{\"type\":{\"accepted\":true,\"value\":\"OBJECT\"},\"unwrapped\":{\"accepted\":true,\"value\":{}}},{\"type\":{\"accepted\":true,\"value\":\"OBJECT\"},\"unwrapped\":{\"accepted\":false}},{\"type\":{\"accepted\":true,\"value\":\"OBJECT\"},\"unwrapped\":{\"accepted\":false}},{\"type\":{\"accepted\":true,\"value\":\"OBJECT\"},\"unwrapped\":{\"accepted\":true,\"value\":{\"x\":11,\"y\":12,\"z\":13}}},{\"type\":{\"accepted\":true,\"value\":\"OBJECT\"},\"unwrapped\":{\"accepted\":true,\"value\":{}}},{\"type\":{\"accepted\":true,\"value\":\"OBJECT\"},\"unwrapped\":{\"accepted\":true,\"value\":{\"x\":11,\"y\":12,\"z\":13}}},{\"type\":{\"accepted\":true,\"value\":\"OBJECT\"},\"unwrapped\":{\"accepted\":true,\"value\":{\"outer\":{\"a\":{\"x\":11,\"y\":12,\"z\":13}}}}},{\"type\":{\"accepted\":true,\"value\":\"OBJECT\"},\"unwrapped\":{\"accepted\":true,\"value\":{\"outer\":{\"a\":{\"x\":11,\"y\":12,\"z\":13}}}}}],\"results\":[{\"accepted\":true,\"value\":1},{\"accepted\":true,\"value\":2},{\"accepted\":true,\"value\":3},{\"accepted\":true,\"value\":4},{\"accepted\":true,\"value\":5},{\"accepted\":true,\"value\":6},{\"accepted\":true,\"value\":7},{\"accepted\":true,\"value\":8}]}",
    ),
  )
}

