      if values.length() <= 2 {
        raise Failure("missing prior value")
      }
      let next = @hocon.value_with_fallback(values[1], values[2])
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  results.push(
    value_native_attempt(() => {
      if values.length() <= 0 {
        raise Failure("missing prior value")
      }
      let next = value_native_create("{x=11,y=12,z=13}")
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  results.push(
    value_native_attempt(() => {
      if values.length() <= 4 {
        raise Failure("missing prior value")
      }
      let next = @hocon.with_only_key(values[3], "x")
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  results.push(
    value_native_attempt(() => {
      if values.length() <= 5 {
        raise Failure("missing prior value")
      }
      let next = @hocon.value_with_fallback(values[5], values[4])
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  results.push(
    value_native_attempt(() => {
      if values.length() <= 6 {
        raise Failure("missing prior value")
      }
      let next = @hocon.at_path(values[6], "outer.a")
      let index = values.length()
      values.push(next)
      index.to_json()
    }),
  )
  results.push(
