    let config = @hocon.parse_sources(
      { name: "<string>", content: "a=[\"1.0\",\"1.0\"]", format: "hocon", },
      object_only=true,
      includes={},
      environment={},
      fallbacks=[],
    )
    (true, @hocon.get_number_list(config, "a").to_json())
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(
    actual,
    (
      true,
      @json.parse(
        "[{\"bits\":\"4607182418800017408\",\"kind\":\"double\",\"value\":1},{\"bits\":\"4607182418800017408\",\"kind\":\"double\",\"value\":1}]",
      ),
    ),
  )
}

