    )
    (
      true,
      @json.parse(
        @hocon.List(
          @hocon.get_object_list(config, "a").map(fields => {
            @hocon.Object(fields)
          }),
        ).to_json_string(),
      ),
    )
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (false, @json.parse("null")))
}

