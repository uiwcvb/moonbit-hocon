///|
test "official extended accessor 18" {
  let actual = try {
    let config = @hocon.parse_sources(
      { name: "<string>", content: "a=0", format: "hocon", },
      object_only=true,
      includes={},
      environment={},
      fallbacks=[],
    )
    (
      true,
      @hocon.get_enum(config, "a", {
        "RED": "RED",
        "GREEN": "GREEN",
        "BLUE": "BLUE",
        "on": "on",
        "yes": "yes",
        "NaN": "NaN",
        "Infinity": "Infinity",
        "蓝色": "蓝色",
        "Α": "Α",
        "_foo": "_foo",
        "$dollar": "$dollar",
      }).to_json(),
    )
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (false, @json.parse("null")))
}

