// Independent Lightbend Config 1.4.9 results; node tools/generate-accessor-tests.mjs then moon fmt.

///|
test "official extended accessor 0" {
  let actual = try {
    let config = @hocon.parse_sources(
      { name: "<string>", content: "a=0", format: "hocon", },
      object_only=true,
      includes={},
      environment={},
      fallbacks=[],
    )
    (true, @hocon.get_number(config, "a").to_json())
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (true, @json.parse("{\"kind\":\"int\",\"value\":\"0\"}")))
}

