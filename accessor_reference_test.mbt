    let config = @hocon.parse_sources(
      { name: "<string>", content: "a={\"꯱\"=20,\"1\"=10}", format: "hocon", },
      object_only=true,
      includes={},
      environment={},
      fallbacks=[],
    )
    (true, @hocon.get_number_list(config, "a").to_json())
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(
    actual,
    (true, @json.parse("[{\"kind\":\"int\",\"value\":\"10\"}]")),
  )
}

