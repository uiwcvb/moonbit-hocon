      @json.parse(
        "[{\"probes\":{\"\\\"quoted.key\\\"\":{\"accepted\":false},\"a\":{\"accepted\":false},\"a.known\":{\"accepted\":false},\"a.x\":{\"accepted\":false},\"a.x.z\":{\"accepted\":false},\"b\":{\"accepted\":false},\"c\":{\"accepted\":false},\"known\":{\"accepted\":false},\"missing\":{\"accepted\":false},\"outer.a\":{\"accepted\":false},\"outer.x\":{\"accepted\":false},\"x\":{\"accepted\":true,\"value\":\"old\"}},\"resolved\":false},{\"probes\":{\"\\\"quoted.key\\\"\":{\"accepted\":false},\"a\":{\"accepted\":false},\"a.known\":{\"accepted\":false},\"a.x\":{\"accepted\":false},\"a.x.z\":{\"accepted\":false},\"b\":{\"accepted\":false},\"c\":{\"accepted\":false},\"known\":{\"accepted\":false},\"missing\":{\"accepted\":false},\"outer.a\":{\"accepted\":false},\"outer.x\":{\"accepted\":false},\"x\":{\"accepted\":true,\"value\":\"old\"}},\"resolved\":false},{\"probes\":{\"\\\"quoted.key\\\"\":{\"accepted\":false},\"a\":{\"accepted\":false},\"a.known\":{\"accepted\":false},\"a.x\":{\"accepted\":false},\"a.x.z\":{\"accepted\":false},\"b\":{\"accepted\":false},\"c\":{\"accepted\":false},\"known\":{\"accepted\":false},\"missing\":{\"accepted\":false},\"outer.a\":{\"accepted\":false},\"outer.x\":{\"accepted\":false},\"x\":{\"accepted\":true,\"value\":13}},\"resolved\":false},{\"probes\":{\"\\\"quoted.key\\\"\":{\"accepted\":true,\"value\":13},\"a\":{\"accepted\":true,\"value\":{\"y\":1}},\"a.known\":{\"accepted\":false},\"a.x\":{\"accepted\":false},\"a.x.z\":{\"accepted\":false},\"b\":{\"accepted\":false},\"c\":{\"accepted\":false},\"known\":{\"accepted\":false},\"missing\":{\"accepted\":false},\"outer.a\":{\"accepted\":false},\"outer.x\":{\"accepted\":false},\"x\":{\"accepted\":true,\"value\":13}},\"resolved\":true,\"value\":{\"a\":{\"y\":1},\"quoted.key\":13,\"x\":13}}]",
      ),
    ),
  )
}

