    let mut config = document_test_parse("a=${b}\nb=${c}\nc=3")
    let states = [
      document_test_state(config, [
        "a", "a.x", "a.x.z", "a.known", "b", "c", "x", "missing", "outer.a", "outer.x",
        "known", "\"quoted.key\"",
      ]),
    ]
    config = @hocon.resolve_with(
      config,
      document_test_parse("missing=7\nother=8"),
      environment={
        "HOCON_DOCUMENT_ENV": "value",
        "HOCON_DOCUMENT_LIST_0": "one",
        "HOCON_DOCUMENT_LIST_1": "two",
      },
      allow_unresolved=false,
    )
    states.push(
      document_test_state(config, [
        "a", "a.x", "a.x.z", "a.known", "b", "c", "x", "missing", "outer.a", "outer.x",
        "known", "\"quoted.key\"",
      ]),
    )
    (true, states.to_json())
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (false, @json.parse("null")))
}

