    let mut config = document_test_parse("a=${missing}\na={x=null}\nb=${a.x}")
    let states = [
      document_test_state(config, [
        "a", "a.x", "a.x.z", "a.known", "b", "c", "x", "missing", "outer.a", "outer.x",
        "known", "\"quoted.key\"",
      ]),
    ]
    config = @hocon.resolve_with(
      config,
      document_test_parse("missing=prefix\nother=suffix"),
      environment={
        "HOCON_DOCUMENT_ENV": "value",
        "HOCON_DOCUMENT_LIST_0": "one",
        "HOCON_DOCUMENT_LIST_1": "two",
      },
      allow_unresolved=true,
    )
    states.push(
      document_test_state(config, [
        "a", "a.x", "a.x.z", "a.known", "b", "c", "x", "missing", "outer.a", "outer.x",
        "known", "\"quoted.key\"",
      ]),
    )
    (true, states.to_json())
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(actual, (false, @json.parse("null")))
}

