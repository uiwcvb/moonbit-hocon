    let mut config = document_test_parse("a=${HOCON_DOCUMENT_ENV}")
    let states = [
      document_test_state(config, [
        "a", "a.x", "a.x.z", "a.known", "b", "c", "x", "missing", "outer.a", "outer.x",
        "known", "\"quoted.key\"",
      ]),
    ]
    config = @hocon.resolve_with(
      config,
      document_test_parse("missing=[2,3]\nother=[4]"),
      environment={
        "HOCON_DOCUMENT_ENV": "value",
        "HOCON_DOCUMENT_LIST_0": "one",
        "HOCON_DOCUMENT_LIST_1": "two",
      },
      allow_unresolved=true,
    )
    states.push(
      document_test_state(config, [
        "a", "a.x", "a.x.z", "a.known", "b", "c", "x", "missing", "outer.a", "outer.x",
        "known", "\"quoted.key\"",
      ]),
    )
    (true, states.to_json())
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(
    actual,
    (
      true,
      @json.parse(
        "[{\"probes\":{\"\\\"quoted.key\\\"\":{\"accepted\":false},\"a\":{\"accepted\":false},\"a.known\":{\"accepted\":false},\"a.x\":{\"accepted\":false},\"a.x.z\":{\"accepted\":false},\"b\":{\"accepted\":false},\"c\":{\"accepted\":false},\"known\":{\"accepted\":false},\"missing\":{\"accepted\":false},\"outer.a\":{\"accepted\":false},\"outer.x\":{\"accepted\":false},\"x\":{\"accepted\":false}},\"resolved\":false},{\"probes\":{\"\\\"quoted.key\\\"\":{\"accepted\":false},\"a\":{\"accepted\":true,\"value\":\"value\"},\"a.known\":{\"accepted\":false},\"a.x\":{\"accepted\":false},\"a.x.z\":{\"accepted\":false},\"b\":{\"accepted\":false},\"c\":{\"accepted\":false},\"known\":{\"accepted\":false},\"missing\":{\"accepted\":false},\"outer.a\":{\"accepted\":false},\"outer.x\":{\"accepted\":false},\"x\":{\"accepted\":false}},\"resolved\":true,\"value\":{\"a\":\"value\"}}]",
      ),
    ),
  )
}

