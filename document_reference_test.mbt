///|
test "official document lifecycle 6" {
  let actual = try {
    let mut config = document_test_parse("{}")
    let states = [
      document_test_state(config, [
        "a", "a.x", "a.x.z", "a.known", "b", "c", "x", "missing", "outer.a", "outer.x",
        "known", "\"quoted.key\"",
      ]),
