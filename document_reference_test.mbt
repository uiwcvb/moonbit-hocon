///|
test "official document lifecycle 2366" {
  let actual = try {
    let mut config = document_test_parse("a=${missing}\na={x=[1]}\nb=${a.x}")
    let states = [
      document_test_state(config, [
        "a", "a.x", "a.x.z", "a.known", "b", "c", "x", "missing", "outer.a", "outer.x",
        "known", "\"quoted.key\"",
      ]),
    ]
    config = @hocon.with_value(
      config,
      "missing",
      @hocon.get_path(document_test_parse("value=7"), ["value"]).unwrap(),
    )
    states.push(
      document_test_state(config, [
        "a", "a.x", "a.x.z", "a.known", "b", "c", "x", "missing", "outer.a", "outer.x",
        "known", "\"quoted.key\"",
      ]),
    )
    config = @hocon.with_value(
      config,
      "other",
      @hocon.get_path(document_test_parse("value=8"), ["value"]).unwrap(),
    )
    states.push(
      document_test_state(config, [
        "a", "a.x", "a.x.z", "a.known", "b", "c", "x", "missing", "outer.a", "outer.x",
        "known", "\"quoted.key\"",
      ]),
    )
    config = @hocon.resolve(
      config,
      environment={
