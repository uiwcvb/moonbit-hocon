///|
test "official document lifecycle 1846" {
  let actual = try {
    let mut config = document_test_parse(
      "a=${missing}\na={x={z=1}}\nb=${a.x.z}",
    )
    let states = [
      document_test_state(config, [
        "a", "a.x", "a.x.z", "a.known", "b", "c", "x", "missing", "outer.a", "outer.x",
        "known", "\"quoted.key\"",
      ]),
    ]
    config = @hocon.with_value(
      config,
      "missing",
      @hocon.get_path(document_test_parse("value=7"), ["value"]).unwrap(),
    )
    states.push(
      document_test_state(config, [
        "a", "a.x", "a.x.z", "a.known", "b", "c", "x", "missing", "outer.a", "outer.x",
        "known", "\"quoted.key\"",
      ]),
    )
    config = @hocon.with_value(
      config,
      "other",
      @hocon.get_path(document_test_parse("value=8"), ["value"]).unwrap(),
    )
    states.push(
      document_test_state(config, [
        "a", "a.x", "a.x.z", "a.known", "b", "c", "x", "missing", "outer.a", "outer.x",
        "known", "\"quoted.key\"",
      ]),
    )
    config = @hocon.resolve(
      config,
      environment={
        "HOCON_DOCUMENT_ENV": "value",
        "HOCON_DOCUMENT_LIST_0": "one",
        "HOCON_DOCUMENT_LIST_1": "two",
      },
      allow_unresolved=false,
    )
    states.push(
      document_test_state(config, [
        "a", "a.x", "a.x.z", "a.known", "b", "c", "x", "missing", "outer.a", "outer.x",
        "known", "\"quoted.key\"",
      ]),
    )
    (true, states.to_json())
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(
    actual,
    (
      true,
      @json.parse(
        "[{\"probes\":{\"\\\"quoted.key\\\"\":{\"accepted\":false},\"a\":{\"accepted\":false},\"a.known\":{\"accepted\":false},\"a.x\":{\"accepted\":false},\"a.x.z\":{\"accepted\":false},\"b\":{\"accepted\":false},\"c\":{\"accepted\":false},\"known\":{\"accepted\":false},\"missing\":{\"accepted\":false},\"outer.a\":{\"accepted\":false},\"outer.x\":{\"accepted\":false},\"x\":{\"accepted\":false}},\"resolved\":false},{\"probes\":{\"\\\"quoted.key\\\"\":{\"accepted\":false},\"a\":{\"accepted\":false},\"a.known\":{\"accepted\":false},\"a.x\":{\"accepted\":false},\"a.x.z\":{\"accepted\":false},\"b\":{\"accepted\":false},\"c\":{\"accepted\":false},\"known\":{\"accepted\":false},\"missing\":{\"accepted\":true,\"value\":7},\"outer.a\":{\"accepted\":false},\"outer.x\":{\"accepted\":false},\"x\":{\"accepted\":false}},\"resolved\":false},{\"probes\":{\"\\\"quoted.key\\\"\":{\"accepted\":false},\"a\":{\"accepted\":false},\"a.known\":{\"accepted\":false},\"a.x\":{\"accepted\":false},\"a.x.z\":{\"accepted\":false},\"b\":{\"accepted\":false},\"c\":{\"accepted\":false},\"known\":{\"accepted\":false},\"missing\":{\"accepted\":true,\"value\":7},\"outer.a\":{\"accepted\":false},\"outer.x\":{\"accepted\":false},\"x\":{\"accepted\":false}},\"resolved\":false},{\"probes\":{\"\\\"quoted.key\\\"\":{\"accepted\":false},\"a\":{\"accepted\":true,\"value\":{\"x\":{\"z\":1}}},\"a.known\":{\"accepted\":false},\"a.x\":{\"accepted\":true,\"value\":{\"z\":1}},\"a.x.z\":{\"accepted\":true,\"value\":1},\"b\":{\"accepted\":true,\"value\":1},\"c\":{\"accepted\":false},\"known\":{\"accepted\":false},\"missing\":{\"accepted\":true,\"value\":7},\"outer.a\":{\"accepted\":false},\"outer.x\":{\"accepted\":false},\"x\":{\"accepted\":false}},\"resolved\":true,\"value\":{\"a\":{\"x\":{\"z\":1}},\"b\":1,\"missing\":7,\"other\":8}}]",
