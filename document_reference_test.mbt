///|
test "official document lifecycle 494" {
  let actual = try {
    let mut config = document_test_parse("a=${?missing}\na={x=1}")
    let states = [
      document_test_state(config, [
        "a", "a.x", "a.x.z", "a.known", "b", "c", "x", "missing", "outer.a", "outer.x",
        "known", "\"quoted.key\"",
      ]),
    ]
    config = @hocon.with_key_value(
      config,
      "quoted.key",
      @hocon.get_path(document_test_parse("value=${x}"), ["value"]).unwrap(),
    )
    states.push(
      document_test_state(config, [
        "a", "a.x", "a.x.z", "a.known", "b", "c", "x", "missing", "outer.a", "outer.x",
        "known", "\"quoted.key\"",
      ]),
    )
    config = @hocon.with_value(
      config,
      "x",
      @hocon.get_path(document_test_parse("value=13"), ["value"]).unwrap(),
    )
    states.push(
      document_test_state(config, [
        "a", "a.x", "a.x.z", "a.known", "b", "c", "x", "missing", "outer.a", "outer.x",
        "known", "\"quoted.key\"",
      ]),
    )
    config = @hocon.resolve(
      config,
      environment={
        "HOCON_DOCUMENT_ENV": "value",
        "HOCON_DOCUMENT_LIST_0": "one",
        "HOCON_DOCUMENT_LIST_1": "two",
      },
      allow_unresolved=true,
    )
    states.push(
      document_test_state(config, [
        "a", "a.x", "a.x.z", "a.known", "b", "c", "x", "missing", "outer.a", "outer.x",
        "known", "\"quoted.key\"",
      ]),
    )
    (true, states.to_json())
  } catch {
    _ => (false, Json::null())
  }
  assert_eq(
    actual,
    (
      true,
      @json.parse(
        "[{\"probes\":{\"\\\"quoted.key\\\"\":{\"accepted\":false},\"a\":{\"accepted\":false},\"a.known\":{\"accepted\":false},\"a.x\":{\"accepted\":true,\"value\":1},\"a.x.z\":{\"accepted\":false},\"b\":{\"accepted\":false},\"c\":{\"accepted\":false},\"known\":{\"accepted\":false},\"missing\":{\"accepted\":false},\"outer.a\":{\"accepted\":false},\"outer.x\":{\"accepted\":false},\"x\":{\"accepted\":false}},\"resolved\":false},{\"probes\":{\"\\\"quoted.key\\\"\":{\"accepted\":false},\"a\":{\"accepted\":false},\"a.known\":{\"accepted\":false},\"a.x\":{\"accepted\":true,\"value\":1},\"a.x.z\":{\"accepted\":false},\"b\":{\"accepted\":false},\"c\":{\"accepted\":false},\"known\":{\"accepted\":false},\"missing\":{\"accepted\":false},\"outer.a\":{\"accepted\":false},\"outer.x\":{\"accepted\":false},\"x\":{\"accepted\":false}},\"resolved\":false},{\"probes\":{\"\\\"quoted.key\\\"\":{\"accepted\":false},\"a\":{\"accepted\":false},\"a.known\":{\"accepted\":false},\"a.x\":{\"accepted\":true,\"value\":1},\"a.x.z\":{\"accepted\":false},\"b\":{\"accepted\":false},\"c\":{\"accepted\":false},\"known\":{\"accepted\":false},\"missing\":{\"accepted\":false},\"outer.a\":{\"accepted\":false},\"outer.x\":{\"accepted\":false},\"x\":{\"accepted\":true,\"value\":13}},\"resolved\":false},{\"probes\":{\"\\\"quoted.key\\\"\":{\"accepted\":true,\"value\":13},\"a\":{\"accepted\":true,\"value\":{\"x\":1}},\"a.known\":{\"accepted\":false},\"a.x\":{\"accepted\":true,\"value\":1},\"a.x.z\":{\"accepted\":false},\"b\":{\"accepted\":false},\"c\":{\"accepted\":false},\"known\":{\"accepted\":false},\"missing\":{\"accepted\":false},\"outer.a\":{\"accepted\":false},\"outer.x\":{\"accepted\":false},\"x\":{\"accepted\":true,\"value\":13}},\"resolved\":true,\"value\":{\"a\":{\"x\":1},\"quoted.key\":13,\"x\":13}}]",
      ),
    ),
  )
}

